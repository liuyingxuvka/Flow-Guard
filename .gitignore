__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
tmp/
/work/
/worktrees/

build/
dist/
*.egg-info/

.venv/
venv/
env/

# FlowGuard keeps runtime evidence and work products local, while the current
# model and verification source are part of the repository's direct-current
# source boundary.  Older paths remain retired by the layout contract.
.flowguard/*
!.flowguard/models/
!.flowguard/models/owners/
!.flowguard/models/owners/**
!.flowguard/models/authority/
!.flowguard/models/authority/**
!.flowguard/models/regression-manifest.json
!.flowguard/verification/
!.flowguard/verification/owners/
!.flowguard/verification/owners/**
# Authority history and intermediate activation records are local evidence.  A
# release publishes only the explicitly staged current/previous snapshot,
# accepted revision, and activation receipt selected by model_authority; future
# upgrades must stage their new current files explicitly.
.flowguard/models/authority/activations/
.flowguard/models/authority/bootstraps/
.flowguard/models/authority/revisions/
.flowguard/models/authority/snapshots/
.flowguard/models/owners/**/__pycache__/
.flowguard/models/owners/**/*.py[cod]
.flowguard/verification/owners/**/__pycache__/
.flowguard/verification/owners/**/*.py[cod]
.flowguard/verification/owners/**/result.json
.flowguard/verification/skill-suite-static/
.agents/skills/**/.skillguard/surface-inventory.json
.agents/skills/**/.skillguard/surface-semantic-map.json
.skillguard/global-router/
kb/
docs/flowguard_adoption_log.md
docs/adoption_review_*.md

# Local verification evidence and machine-bound archived execution contracts
openspec/**/run-artifacts/
openspec/**/verification-receipts/
openspec/**/verification-report.json
openspec/**/verification-provenance.json
openspec/changes/archive/**/verification-contract.yaml
openspec/changes/**/strict-check-temp.log
